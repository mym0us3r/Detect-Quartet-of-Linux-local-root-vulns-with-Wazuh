## LPE Quartet 2026 - auditd sensor rules for Wazuh (lpe_quartet.xml)
## DirtyAH6 CVE-2026-80844 | TUNderflow CVE-2026-81000
## PPPoEject CVE-2026-68121 | DiagSpill CVE-2026-74469
## Author: Kislley Rodrigues

## Common precursor - unprivileged user namespace
-a always,exit -F arch=b64 -S unshare,setns -F uid!=0 -k lpe_quartet_userns
-a always,exit -F arch=b32 -S unshare,setns -F uid!=0 -k lpe_quartet_userns

## DirtyAH6 - raw IPv6 socket (SOCK_RAW and SOCK_RAW|SOCK_CLOEXEC) and NETLINK_XFRM
-a always,exit -F arch=b64 -S socket -F a0=10 -F a1=3 -F uid!=0 -k lpe_quartet_rawv6
-a always,exit -F arch=b32 -S socket -F a0=10 -F a1=3 -F uid!=0 -k lpe_quartet_rawv6
-a always,exit -F arch=b64 -S socket -F a0=10 -F a1=524291 -F uid!=0 -k lpe_quartet_rawv6
-a always,exit -F arch=b32 -S socket -F a0=10 -F a1=524291 -F uid!=0 -k lpe_quartet_rawv6
-a always,exit -F arch=b64 -S socket -F a0=16 -F a2=6 -F uid!=0 -k lpe_quartet_xfrm
-a always,exit -F arch=b32 -S socket -F a0=16 -F a2=6 -F uid!=0 -k lpe_quartet_xfrm

## TUNderflow - /dev/net/tun access and NETLINK_ROUTE socket
-w /dev/net/tun -p rwxa -k lpe_quartet_tun
-a always,exit -F arch=b64 -S socket -F a0=16 -F a2=0 -F uid!=0 -k lpe_quartet_netlink_route
-a always,exit -F arch=b32 -S socket -F a0=16 -F a2=0 -F uid!=0 -k lpe_quartet_netlink_route

## DiagSpill - SCTP socket and NETLINK_SOCK_DIAG query
-a always,exit -F arch=b64 -S socket -F a2=132 -F uid!=0 -k lpe_quartet_sctp
-a always,exit -F arch=b32 -S socket -F a2=132 -F uid!=0 -k lpe_quartet_sctp
-a always,exit -F arch=b64 -S socket -F a0=16 -F a2=4 -F uid!=0 -k lpe_quartet_sockdiag
-a always,exit -F arch=b32 -S socket -F a0=16 -F a2=4 -F uid!=0 -k lpe_quartet_sockdiag

## Low-confidence IOC - execution from /tmp and /dev/shm
-w /tmp -p x -k lpe_quartet_tmp_exec
-w /dev/shm -p x -k lpe_quartet_tmp_exec
